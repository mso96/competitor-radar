{
  "name": "competitor-radar",
  "version": "0.1.0",
  "private": false,
  "description": "An open-source competitor analysis agent that watches the web and tells you what your competitors are doing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "scan": "node --import tsx src/scan.ts",
    "monitor": "node --import tsx src/scan.ts monitor",
    "discover": "node --import tsx src/scan.ts discover",
    "cloud:types": "wrangler types",
    "cloud:typecheck": "wrangler types && tsc --noEmit -p tsconfig.cloudflare.json",
    "cloud:dev": "wrangler dev",
    "cloud:deploy": "wrangler deploy --secrets-file .dev.vars",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  }
}
